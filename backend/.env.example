# Copy to backend/.env and fill in. Every key is OPTIONAL: a provider with no key is skipped
# (status NOT_CONFIGURED) and the next provider in the fallback chain is used.
# Sign-up steps for each are in docs/api-keys.md

# --- Paid / freemium market data -------------------------------------------------
# Financial Modeling Prep  (free 250/day US-only; Premium ~USD 59/mo for US+CA+UK)
FMP_API_KEY=
# EODHD                    (free 20 calls/day; Historian $19.99, All-in-One $99.99)
EODHD_API_KEY=
# Alpha Vantage            (free 25 calls/day; mostly US fundamentals)
ALPHAVANTAGE_API_KEY=
# Finnhub                  (free 60 calls/min; profile, quote, company news)
FINNHUB_API_KEY=
# Twelve Data              (free 800 calls/day; daily prices backup)
TWELVEDATA_API_KEY=

# --- Free official sources (no key needed) ----------------------------------------
# SEC requires a descriptive User-Agent with a contact address. Put YOUR email here.
SEC_USER_AGENT=InvestmentDashboard/0.1 (personal research; contact: you@example.com)

# --- App ----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/app.db
PRESENTATION_CURRENCY=CAD
# Peer groups need at least this many members before falling back to a broader cohort (spec §6)
PEER_MIN_SIZE=30
# Fallback order per dataset (comma separated provider ids). Unknown/unconfigured ids are skipped.
CHAIN_PROFILE=yahoo,fmp,eodhd,finnhub
CHAIN_PRICES=yahoo,fmp,eodhd,twelvedata,alphavantage
CHAIN_FINANCIALS=yahoo,fmp,eodhd,alphavantage,sec_edgar
CHAIN_ESTIMATES=yahoo,fmp,eodhd
CHAIN_PRICE_TARGETS=yahoo,fmp,eodhd
CHAIN_NEWS=finnhub,fmp,yahoo_rss,yahoo,eodhd,google_news,gdelt
CHAIN_FX=boc,frankfurter,yahoo
CHAIN_FUND_PROFILE=yahoo,fmp,eodhd
# issuer = official full holdings files (SSGA, iShares Canada); Yahoo = top-10 only
CHAIN_HOLDINGS=issuer,fmp,eodhd,yahoo
# Universe: starter | core (S&P 500 + TSX + FTSE 100) | global (core + Asia, Europe, EM) | extended (+ FTSE 250, CSI 300)
UNIVERSE=global
# Parallel workers for enrichment (free Yahoo throttles above ~4)
INGEST_WORKERS=4
